# Copy these values into your hosting provider's environment settings.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WUDE_SECRET_KEY=replace-with-a-long-random-secret
WUDE_ADMIN_EMAIL=admin@example.com
WUDE_ADMIN_PASSWORD=replace-with-a-strong-unique-password
WUDE_ACCESS_TOKEN_MINUTES=720
WUDE_DATA_DIR=./data
WUDE_CORS_ORIGINS=http://localhost:3000
